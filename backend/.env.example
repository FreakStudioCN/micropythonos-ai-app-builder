# Automatic provider order. Only auto may fail over to another provider.
AI_PROVIDER_ORDER=deepseek_primary,deepseek_secondary,aigocode

# Primary DeepSeek provider. The legacy DEEPSEEK_API_KEY/BASE_URL/MODEL names
# remain supported when these primary variables are absent.
DEEPSEEK_PRIMARY_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_PRIMARY_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRIMARY_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional secondary DeepSeek-compatible endpoint.
# DEEPSEEK_SECONDARY_API_KEY=replace_with_your_deepseek_api_key
# DEEPSEEK_SECONDARY_BASE_URL=https://api.deepseek.com
# DEEPSEEK_SECONDARY_MODEL=deepseek-v4-flash

# Optional AIGoCode OpenAI-compatible endpoint.
# AIGOCODE_API_KEY=replace_with_your_aigocode_api_key
AIGOCODE_BASE_URL=https://api.aigocode.app/v1
AIGOCODE_MODEL=glm-4.7

# Bounded upstream retries, failover, timeout, and circuit-breaker settings.
AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=60
AI_OVERALL_TIMEOUT_SECONDS=120
AI_UPSTREAM_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=2
AI_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

# Validation retries after a model response was received successfully.
DEEPSEEK_MAX_ATTEMPTS=1
DEEPSEEK_MAX_TOKENS=3200

# Comma-separated browser origins. localhost/127.0.0.1 ports 5173 and 5174
# are always allowed by the local development server.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional shared token. Leave empty for localhost-only development.
# MPOS_API_TOKEN=replace_with_a_long_random_token

# Optional persistent session directory.
# MPOS_SESSION_ROOT=/var/lib/mpos-builder/sessions

# Local SQLite fallback. Cloud deployments must use DATABASE_URL instead.
# MPOS_AUTH_DB_PATH=/var/lib/mpos-builder/app.db
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Username/password login session cookie.
# MPOS_COOKIE_SECURE=true
# MPOS_COOKIE_SAMESITE=lax

# Supabase Storage S3-compatible server credentials. Create a private bucket
# named mpos-sessions and copy these values from the Supabase S3 settings.
# MPOS_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# MPOS_STORAGE_REGION=ap-southeast-1
# MPOS_STORAGE_ACCESS_KEY_ID=replace_with_server_access_key
# MPOS_STORAGE_SECRET_ACCESS_KEY=replace_with_server_secret_key
# Optional Supabase S3 session authentication. Use the project ref as the
# access key ID, the anon key as the secret access key, and a server-side JWT
# as this session token. Never expose the session token to the frontend.
# MPOS_STORAGE_SESSION_TOKEN=replace_with_server_side_jwt
# MPOS_STORAGE_BUCKET=mpos-sessions

# Render sets this to true so the service refuses to start with temporary
# SQLite/filesystem storage. Leave unset for local development.
# MPOS_REQUIRE_DURABLE_STORAGE=true

# Keep disabled outside a controlled local product demo. When enabled, the
# backend exposes a session-scoped error injection endpoint for retry demos.
MPOS_DEMO_ERROR_INJECTION=false

# Public GET /api/system/status remains available while maintenance is enabled.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=系统正在升级，请稍后重试。
MAINTENANCE_RETRY_AFTER_SECONDS=300
