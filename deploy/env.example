# Template for /srv/mpos/.env — exactly one non-secret line: the immutable image pin.
# The deploy job rewrites this line on every deployment (and restores the previous
# value if `docker compose up -d --wait` fails). Rollback = set the previous verified
# digest and run `docker compose up -d --wait`.
MPOS_IMAGE=ghcr.io/freakstudiocn/micropythonos-ai-app-builder@sha256:CHANGE-ME-digest
