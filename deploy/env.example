# One non-secret line to ADD to the existing stack directory's .env — the
# directory that already holds the plugin backend's compose.yml, not a new
# /srv/mpos. If that .env does not exist yet, create it with just this line.
#
# The deploy job rewrites ONLY the MPOS_IMAGE line, in place, preserving every
# other line in the file (the stack is now shared — anything else living in
# this .env belongs to someone else). On failure it restores the previous pin
# and brings mpos-app back on it.
#
# Rollback = set the previous verified digest here and run
#   docker compose up -d --wait mpos-app
MPOS_IMAGE=ghcr.io/freakstudiocn/micropythonos-ai-app-builder@sha256:CHANGE-ME-digest
