# Add this block to the host Caddyfile — the same one that already serves
# blockless.upypi.net for the plugin backend — then reload Caddy.
#
# Caddy is a service in the same compose stack (it publishes :80/:443 and mounts
# this file), so `mpos-app` resolves by service name over compose's implicit
# `default` network. That is the whole reason compose.mpos-services.yml lists
# `default` on mpos-app: a service that declares any network leaves `default`,
# and Caddy would stop resolving it.
#
# Confirm the final hostname with the ops owner before going live.
mpos.upypi.net {
	reverse_proxy mpos-app:10000
}
