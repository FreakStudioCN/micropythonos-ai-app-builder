# Add this block to the host Caddyfile — the same one that already serves
# blockless.upypi.net for the plugin backend — then reload Caddy.
#
# `mpos-app` resolves by service name because it joins the existing `edge`
# network (caddy_net) declared in the host's compose.yml. Nothing to add there:
# that network is already defined for the plugin backend, which is why
# compose.mpos-services.yml references `edge` without redefining it.
#
# Confirm the final hostname with the ops owner before going live.
mpos.upypi.net {
    reverse_proxy mpos-app:10000
}
