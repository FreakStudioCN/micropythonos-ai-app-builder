{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blockless.dev/mpos-ai-app/v1/deploy-result.schema.json",
  "title": "mpos-deploy-app-web deploy result",
  "allOf": [
    {
      "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/resultBase"
    },
    {
      "type": "object",
      "required": [
        "mode",
        "hardware_available",
        "hardware_id",
        "serial_port",
        "micropythonos_installed",
        "permission_decisions",
        "commands",
        "logs"
      ],
      "properties": {
        "schema_version": {
          "const": "mpos-deploy-app-web-v1"
        },
        "phase": {
          "const": "mpos-deploy-app-web"
        },
        "stage": {
          "const": "deploy"
        },
        "mode": {
          "enum": [
            "desktop-preview",
            "web-preview",
            "browser-device-handoff",
            "webserial",
            "mpremote",
            "device-copy",
            "mpk-install",
            "install-site",
            "local-flash"
          ]
        },
        "hardware_available": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hardware_id": {
          "description": "DeviceInfo.hardware_id, diagnostics only. Never a selector or a precondition, and never defaulted to a specific board.",
          "type": [
            "string",
            "null"
          ]
        },
        "detected_hardware_id": {
          "description": "Hardware id actually read back from the authorised device.",
          "type": [
            "string",
            "null"
          ]
        },
        "board_metadata_is_advisory": {
          "description": "Always true: board_capabilities.json may only add context, never accept or reject a device.",
          "type": "boolean"
        },
        "capability_versions": {
          "description": "Pinned Skills/MPOS commits and capability schema, so resuming a session cannot silently switch API snapshots.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "runtime_capability_results": {
          "description": "Runtime probe evidence per required capability. Probe results are authoritative over the static board table.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "available"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "available": {
                "description": "null means the probe could not be evaluated. That is not the same as absent hardware.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "probe": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "serial_port": {
          "type": [
            "string",
            "null"
          ]
        },
        "micropythonos_installed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "permission_decisions": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/permissionDecision"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "transport",
                  "summary"
                ],
                "properties": {
                  "transport": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "client_attested": {
          "type": "boolean"
        },
        "server_verified": {
          "type": "boolean"
        },
        "usb_vendor_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "usb_product_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "app_installed": {
          "type": "boolean"
        },
        "app_launched": {
          "type": "boolean"
        },
        "installed_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "install_url": {
          "type": "string",
          "format": "uri"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "handoff": {
          "type": "object",
          "required": [
            "next_phase"
          ],
          "properties": {
            "next_phase": {
              "enum": [
                "mpos-publish-app-web",
                null
              ]
            },
            "reason": {
              "type": "string"
            },
            "required_artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
