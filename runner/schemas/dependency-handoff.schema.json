{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blockless.dev/mpos-ai-app/v1/dependency-handoff.schema.json",
  "title": "mpos-prepare-deps-web dependency handoff",
  "allOf": [
    {
      "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/resultBase"
    },
    {
      "type": "object",
      "required": [
        "imports",
        "runtime_files",
        "adapter_requirements",
        "sync_needs_adapter",
        "async_compatible"
      ],
      "properties": {
        "schema_version": {
          "const": "mpos-prepare-deps-web-v1"
        },
        "phase": {
          "const": "mpos-prepare-deps-web"
        },
        "stage": {
          "const": "prepare_deps"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "runtime_files": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/relativePath"
              },
              {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/relativePath"
                  },
                  "sha256": {
                    "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/sha256"
                  },
                  "purpose": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "adapter_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sync_needs_adapter": {
          "type": "boolean"
        },
        "async_compatible": {
          "type": "boolean"
        },
        "handoff": {
          "type": "object",
          "required": [
            "next_phase"
          ],
          "properties": {
            "next_phase": {
              "enum": [
                "mpos-gen-app-web",
                null
              ]
            },
            "reason": {
              "type": "string"
            },
            "required_artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
