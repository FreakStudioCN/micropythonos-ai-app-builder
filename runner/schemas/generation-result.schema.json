{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blockless.dev/mpos-ai-app/v1/generation-result.schema.json",
  "title": "mpos-gen-app-web generation result",
  "allOf": [
    {
      "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/resultBase"
    },
    {
      "type": "object",
      "required": [
        "mode",
        "app",
        "files_written",
        "api_usage",
        "validation"
      ],
      "properties": {
        "schema_version": {
          "const": "mpos-gen-app-web-v1"
        },
        "phase": {
          "const": "mpos-gen-app-web"
        },
        "stage": {
          "const": "generate"
        },
        "mode": {
          "enum": [
            "create",
            "repair",
            "revise"
          ]
        },
        "app": {
          "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/app"
        },
        "required_capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_accessories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "runtime_fallbacks": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "physical_validation_required": { "type": "boolean" },
        "capability_contract": { "type": "object", "additionalProperties": true },
        "visual_asset_plan": {
          "type": "object",
          "additionalProperties": true
        },
        "visual_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "runtime_path",
              "runtime_format",
              "runtime_bytes",
              "runtime_sha256",
              "generation_mode",
              "fallback"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "purpose": { "type": "string" },
              "runtime_path": {
                "type": "string",
                "pattern": "^assets/images/[a-z][a-z0-9_]{0,63}\\.bin$"
              },
              "runtime_format": { "enum": ["RGB565", "RGB565A8", "A8"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "runtime_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
              "runtime_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "fallback": { "type": "string", "minLength": 1 },
              "generation_mode": { "enum": ["procedural", "web", "external"] },
              "source_page_url": { "type": "string" },
              "license": { "type": "string" },
              "attribution": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "skill_commit": { "type": ["string", "null"] },
        "mpos_commit": { "type": ["string", "null"] },
        "board_capabilities_schema": { "type": "object", "additionalProperties": true },
        "files_written": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/relativePath"
              },
              {
                "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/fileRecord"
              }
            ]
          }
        },
        "api_usage": {
          "type": "object",
          "required": [
            "checked",
            "missing"
          ],
          "properties": {
            "checked": {
              "type": "boolean"
            },
            "used": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "required": [
            "gates"
          ],
          "properties": {
            "gates": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/gate"
              }
            }
          },
          "additionalProperties": false
        },
        "handoff": {
          "type": "object",
          "required": [
            "next_phase"
          ],
          "properties": {
            "next_phase": {
              "enum": [
                "mpos-test-app-web",
                null
              ]
            },
            "reason": {
              "type": "string"
            },
            "required_artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
