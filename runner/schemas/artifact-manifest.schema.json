{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blockless.dev/mpos-ai-app/v1/artifact-manifest.schema.json",
  "title": "MicroPythonOS AI App artifact manifest",
  "type": "object",
  "required": [
    "artifacts"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/protocolVersion"
    },
    "session_id": {
      "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/sessionId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/timestamp"
    },
    "final_artifacts_only": {
      "type": "boolean"
    },
    "publish_ready": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.blockless.dev/mpos-ai-app/v1/common-defs.schema.json#/$defs/artifact"
      }
    }
  },
  "additionalProperties": false
}
