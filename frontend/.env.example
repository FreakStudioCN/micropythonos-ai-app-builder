# Copy this file to .env.local when a port or host must be overridden.
VITE_API_BASE=http://localhost:8000
# VITE_WASM_BASE=http://localhost:8000
VITE_UPLOAD_CHUNK_SIZE=512
# Client-side generation limits are disabled by default. The backend owns job
# completion/failure; set positive values only when an installation explicitly
# needs a browser wait limit.
VITE_GENERATION_IDLE_TIMEOUT_MS=0
VITE_GENERATION_OVERALL_TIMEOUT_MS=0

# Only needed when backend MPOS_API_TOKEN is configured.
# VITE_MPOS_API_TOKEN=replace_with_the_same_token
